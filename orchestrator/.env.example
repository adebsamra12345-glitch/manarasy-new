# ==========================================
# إعدادات خدمة Orchestrator (orchestrator/.env.example)
# ==========================================

# مفتاح الخدمة السري بين تطبيق منارة والـ Orchestrator (يجب تغييره في الإنتاج)
ORCHESTRATOR_SERVICE_KEY=change-me-in-production-min-32-chars-secret

# عناوين خدمات الذكاء الاصطناعي على جهاز الـ GPU عبر Tailscale (adebserver: 100.119.62.40)
VLLM_BASE_URL=http://100.119.62.40:8000/v1
VLLM_MODEL_NAME=base
# توجيه النموذج حسب المهمة: AGENT للأدوات (/v1/agent/turn)، TEXT للكتابة الحرة، FALLBACK لإعادة المحاولة عند ظهور حروف CJK
VLLM_MODEL_AGENT=manarasy
VLLM_MODEL_TEXT=base
VLLM_MODEL_FALLBACK=base
# تجاوز اختياري لكل نقطة (فارغ = TEXT). قارن بـ eval/ab_endpoints.py قبل تثبيت manarasy لهما
VLLM_MODEL_EVALUATION_NOTE=
VLLM_MODEL_REPORT_INSIGHT=
STT_BASE_URL=http://100.119.62.40:8001/v1
STT_MODEL_NAME=deepdml/faster-whisper-large-v3-turbo-ct2

# وضع التشغيل الخلفي للأدوات (mock للاختبارات، أو django للربط الفعلي بـ Django)
AGENT_BACKEND=django
DJANGO_BASE_URL=http://manarasy-backend:8000
AGENT_JWT_SECRET=change-me-jwt-secret-for-mock-tests

# المهلات (بالثواني) وإعادة المحاولة والـ Circuit Breaker
LLM_TIMEOUT_SECONDS=25.0
STT_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT_SECONDS=30.0

# حدود حجم الطلب والـ Tokens
MAX_REQUEST_BODY_BYTES=65536
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=512
DEFAULT_TEMPERATURE=0.2

# حدود معدل الطلبات (Rate Limiting لكل مستخدم في الدقيقة حسب الدور)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STUDENT_PER_MIN=10
RATE_LIMIT_TEACHER_PER_MIN=30
RATE_LIMIT_MANAGER_PER_MIN=45
RATE_LIMIT_ADMIN_PER_MIN=60

