# ==========================================
# إعدادات عقدة الـ GPU (gpu-stack/.env.example)
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئة جهاز الـ GPU (adebserver)
# ==========================================

# عنوان Tailscale IPv4 الخاص بجهاز الـ GPU (يُمنع استخدام 0.0.0.0)
# يمكنك الحصول عليه عبر: tailscale ip -4
TS_IP=100.119.62.40

# المسار الفعلي على جهاز الـ GPU الذي يحتوي على مجلد Qwen3-8B
# بحيث يكون النموذج داخل الحاوية في /models/Qwen3-8B
MODELS_DIR=/models

# حدود فحص الذاكرة في up.sh (بالميجابايت)
NEED_MB=9100
MIN_MARGIN_MB=2500

