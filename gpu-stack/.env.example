# ==========================================
# إعدادات عقدة الـ GPU (gpu-stack/.env.example)
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئة جهاز الـ GPU (adebserver)
# ==========================================

# عنوان Tailscale IPv4 الخاص بجهاز الـ GPU (يُمنع استخدام 0.0.0.0)
# يمكنك الحصول عليه عبر: tailscale ip -4
TS_IP=100.119.62.40

# المسار الفعلي على جهاز الـ GPU الذي يحتوي على مجلد Qwen3-8B
# بحيث يكون النموذج داخل الحاوية في /models/Qwen3-8B
MODELS_DIR=/models

# حدود فحص الذاكرة في up.sh (بالميجابايت)
# vLLM 0.33 بتكميم FP8 و gpu-memory-utilization=0.80 يحجز ~12GB => الكرت يجب أن يكون شبه مخصص.
# إن لزم التعايش مع خدمات GPU أخرى: استخدم نموذجاً مكمَّماً مسبقاً AWQ 4-bit (غير مُختبر)
# وخفّض --gpu-memory-utilization في docker-compose.yml و NEED_MB تبعاً لذلك.
NEED_MB=13000
MIN_MARGIN_MB=2500

# محوّلات LoRA على نفس النموذج الأساسي: أزواج "اسم=مجلد داخل ./loras" مفصولة بمسافات.
# يُتخطّى تلقائياً أي محوّل لا يوجد له adapter_config.json.
# مثال لعدة منصات: LORA_MODULES="manarasy=manarasy-qwen3-v1 institutes=institutes-qwen3-v1 student_help=student-help-qwen3-v1"
LORA_MODULES="manarasy=manarasy-qwen3-v1"

# التدريب (training/run_train.sh): يعمل داخل صورة Docker لأن المضيف لا يحوي torch.
# التدريب يحتاج كرتاً شبه فارغ: 0.44 يفشل بـ OOM، و0.85 مُختبر (Peak ~9.5GB).
TRAINER_IMAGE=docker-trainer:latest
MAX_VRAM_FRACTION=0.85
TRAIN_NEED_MB=12000

