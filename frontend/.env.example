# ==========================================
# إعدادات الواجهة الأمامية لمنصة منارة (frontend/.env.example)
# انسخ هذا الملف إلى .env.local أو .env.production
# ==========================================

# رابط الخادم الخلفي (Django API)
VITE_API_URL=https://api.manarasy.io

# أعلام ميزات الذكاء الاصطناعي (Feature Flags)
VITE_FEATURE_AI_MASTER=true
VITE_FEATURE_AI_CHAT=true
VITE_FEATURE_AI_AGENT=true
VITE_FEATURE_AI_EVAL_NOTES=true
VITE_FEATURE_AI_REPORT_INSIGHTS=true
VITE_FEATURE_AI_QUIZ=true
VITE_FEATURE_AI_STT=true

