# ==========================================
# إعدادات بيئة تطبيق منارة الخلفي (backend/.env.example)
# انسخ هذا الملف إلى .env أو .env.prod وعدّل القيم للإنتاج
# ==========================================

DEBUG=False
SECRET_KEY=change-me-in-production-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,api.manarasy.io
CORS_ALLOWED_ORIGINS=https://manarasy.io,https://www.manarasy.io

# قاعدة البيانات المركزية (PostgreSQL)
POSTGRES_DB=manara_db
POSTGRES_USER=manara_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=manarasy-db
POSTGRES_PORT=5432

# JWT الخاص بالمساجد وأدمن المنصة
JWT_SECRET_KEY=change-me-tenant-jwt-secret
PLATFORM_JWT_SECRET=change-me-platform-jwt-secret
SHAM_CASH_WEBHOOK_SECRET=change-me-sham-cash-hmac-secret

# التخزين المؤقت والمهام غير المتزامنة (اختياري)
REDIS_URL=
PROVISIONING_ASYNC=False

# ==========================================
# إعدادات خدمة الذكاء الاصطناعي (Orchestrator)
# التطبيق يتصل بالـ Orchestrator فقط ولا يتصل بـ vLLM مباشرة
# ==========================================
ORCHESTRATOR_BASE_URL=http://manarasy-orchestrator:8080
ORCHESTRATOR_SERVICE_KEY=change-me-in-production-min-32-chars-secret
ORCHESTRATOR_TIMEOUT_SECONDS=8.0

# أعلام ميزات الذكاء الاصطناعي (Feature Flags)
AI_FEATURE_MASTER_ENABLED=True
AI_FEATURE_ASSISTANT_CHAT=True
AI_FEATURE_VOICE_TEXT_AGENT=True
AI_FEATURE_EVALUATION_NOTES=True
AI_FEATURE_REPORT_INSIGHTS=True
AI_FEATURE_QUIZ_GENERATOR=True
AI_FEATURE_STT_TRANSCRIPTION=True

